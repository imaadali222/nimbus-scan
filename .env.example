API_PORT=4000
WORKER_PORT=4010
WORKER_POLL_MS=2000
WORKER_MAX_RETRIES=2
WORKER_EXPORT_OUTBOX_DIR="./.runtime/exports/outbox"
# Baseline datasource (SQLite):
DATABASE_URL="file:./apps/api/prisma/dev.db"
# If moving to PostgreSQL, update Prisma datasource provider in schema.prisma first.
# Development fallback only. Production/staging must set a strong unique value.
JWT_SECRET="dev-only-change-me-please"
API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
SCANNER_RUNTIME="docker"
SCANNER_ARTIFACTS_DIR="./.runtime/artifacts/scans"
PROVIDER_CAPABILITIES_FILE="./.runtime/provider-capabilities.json"
PROWLER_IMAGE="ghcr.io/prowler-cloud/prowler:4.6.0"
KUBESCAPE_IMAGE="quay.io/kubescape/kubescape:v3.0.26"
PROWLER_BINARY="prowler"
KUBESCAPE_BINARY="kubescape"
AWS_FIRST_MODE=true
